    {
      "type": "timeseries",
      "title": "Tráfego do proxy de saída",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(container_network_receive_bytes_total{service=\"egress-proxy\"}[5m]))",
          "legendFormat": "recebido"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(container_network_transmit_bytes_total{service=\"egress-proxy\"}[5m]))",
          "legendFormat": "enviado"
        }
      ],
