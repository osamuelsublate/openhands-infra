        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (allow) (count_over_time({service=\"egress-proxy\"} |= \"CANONICAL-PROXY-DECISION\" | json [1m]))",
