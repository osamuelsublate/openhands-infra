    {
      "type": "stat",
      "title": "Custo no período (USD)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({source=\"spanlogs\"} | logfmt | unwrap gen_ai_usage_cost | __error__=\"\" [$__range]))",
          "queryType": "instant"
        }
