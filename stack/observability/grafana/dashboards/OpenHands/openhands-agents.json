    {
      "type": "row",
      "title": "Operações dos agentes (traces)",
      "collapsed": false,
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Operações mais frequentes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(20, sum by (span_name) (increase(traces_spanmetrics_calls_total{service=\"openhands-agent\"}[$__range])))",
          "format": "table",
          "instant": true
        }
      ],
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "span_name": "operação",
              "Value": "execuções"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "execuções",
                "desc": true
              }
            ]
          }
        }
      ]
    },
