# ══════════════════════════════════════════════════════════════════════════════
# Modelo das variáveis de produção. O arquivo real é secrets/prod.sops.env,
# CIFRADO com SOPS + age. Nunca commite valores em texto plano.
#
#   just secrets-init   → gera o prod.sops.env com chaves aleatórias
#   just secrets-edit   → abre no $EDITOR (decifra e recifra ao salvar)
# ══════════════════════════════════════════════════════════════════════════════

# ── Domínios e TLS ──
OH_DOMAIN=openhands.samuelsublate.com.br
# E-mail para avisos do Let's Encrypt
ACME_EMAIL=voce@exemplo.com.br
# Descomente para testar sem gastar o rate limit do Let's Encrypt:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Allowlist opcional de IPs de origem (separados por espaço):
# CADDY_ALLOWED_CIDRS=203.0.113.4/32

TZ=America/Sao_Paulo

# ── OpenHands ──
# Chave de acesso à UI/API (openssl rand -hex 32). É o que você digita na tela de login.
LOCAL_BACKEND_API_KEY=
# Cifra settings.json/secrets.json (onde ficam as chaves de LLM). PERDER = perder as configs.
OH_SECRET_KEY=
OH_MAX_CONCURRENT_RUNS=3

# ── Grafana e alertas ──
GRAFANA_ADMIN_PASSWORD=
# Bot criado com o @BotFather; chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Backup (ative com COMPOSE_PROFILES=backup) ──
# COMPOSE_PROFILES=backup
# BACKUP_AGE_PUBLIC_KEYS=age1...            (chave pública; a privada fica OFFLINE)
# BACKUP_S3_ENDPOINT=s3.us-east-005.backblazeb2.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_PATH=openhands
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_RETENTION_DAYS=14
# BACKUP_NOTIFICATION_URLS=telegram://<token>@telegram?chats=<chat_id>
